server {
    listen 443 ssl http2;
    server_name steam.example.com;

    # Configure certificate paths using your existing ACME setup.
    ssl_certificate /etc/letsencrypt/live/steam.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/steam.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
    }
}
