# Required: replace these placeholders before starting the service.
PUBLIC_BASE_URL=https://steam.example.com
STEAM_WEB_API_KEY=replace_with_your_steam_web_api_key
ALLOWED_STEAM_IDS=00000000000000000

# Generate with: openssl genpkey -algorithm Ed25519 -out oauth-ed25519.pem
# Paste the complete PEM value here, including BEGIN/END lines.
OAUTH_SIGNING_KEY='replace_with_the_complete_ed25519_private_key_pem'
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_at_least_32_random_bytes

# Defaults from config.py. Change these only if needed.
APP_HOST=0.0.0.0
APP_PORT=8000
STORE_COUNTRY_DEFAULT=KZ
STORE_LANGUAGE_DEFAULT=english
STORE_CURRENCY_DEFAULT=KZT
DATABASE_URL=sqlite+aiosqlite:////data/steam-companion.sqlite3
ENABLE_UNOFFICIAL_STOREFRONT=false
MCP_TOOLSET=core
LIBRARY_CACHE_TTL_SECONDS=300
STORE_CACHE_TTL_SECONDS=300
WALLET_STALE_AFTER_SECONDS=86400
LOG_LEVEL=INFO
STEAM_TIMEOUT_SECONDS=9
STEAM_CONNECT_TIMEOUT_SECONDS=3
